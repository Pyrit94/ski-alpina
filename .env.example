# Variablen für Coolify (Ressource "ski-alpina", Developer view) bzw. lokal für
#   docker compose -f docker-compose.coolify.yml --env-file .env up --build
# Keine echten Werte ins Repo. Geheimnisse liegen im Passwortmanager.

# Postgres im Compose-Stack. Zufällig: openssl rand -hex 24
POSTGRES_PASSWORD=

# Öffentliche Adresse, mit https (TLS macht Cloudflare).
BETTER_AUTH_URL=https://ski.rasselbande.work
# Zufällig, mind. 32 Byte: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Google-Client "Rasselbande Web" (Projekt Wissensablage). Redirect-URI dort ergänzen:
#   https://ski.rasselbande.work/api/auth/oauth2/callback/grok-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Leer = Michael und Johanna (DEFAULT_ROSTER). Ersetzt die Liste, ergänzt nicht.
ALLOWED_EMAILS=
# Optional: weitere Hostnamen (Komma), z. B. ein Alias.
ALLOWED_HOSTS=

# Optional: Push aufs Handy (ntfy), z. B. https://ntfy.sh/ski-alpina-<langes-zufallswort>
# Beide abonnieren das Thema in der ntfy-App. Wer das Thema kennt, liest mit – also geheim halten.
NTFY_URL=
